generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EVALUATOR
  CANDIDATE
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(CANDIDATE)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  submissions  Submission[]
  attempts     Attempt[]
}

model Assessment {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  timeLimit   Int
  createdAt   DateTime   @default(now())
  questions   Question[]
  attempts    Attempt[]
}

model Question {
  id           Int         @id @default(autoincrement())
  title        String
  description  String
  language     String
  score        Int
  assessment   Assessment  @relation(fields: [assessmentId], references: [id])
  assessmentId Int
  testCases    TestCase[]
}

model TestCase {
  id             Int       @id @default(autoincrement())
  input          String
  expectedOutput String
  question       Question  @relation(fields: [questionId], references: [id])
  questionId     Int
}

// cuándo empezó el candidato el assessment
model Attempt {
  id           Int        @id @default(autoincrement())
  user         User       @relation(fields: [userId], references: [id])
  userId       Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  assessmentId Int
  startedAt    DateTime   @default(now())

  @@unique([userId, assessmentId])
}

model Submission {
  id          Int       @id @default(autoincrement())
  // correo del candidato al enviar
  candidateId String
  user        User?     @relation(fields: [userId], references: [id])
  userId      Int?
  questionId  Int
  code        String
  language    String
  passed      Boolean?
  score       Int?
  createdAt   DateTime  @default(now())
}
